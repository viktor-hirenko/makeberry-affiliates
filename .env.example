CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Google Analytics 4.
# Прод-ID (G-HR253V0PJX) зашит в src/composables/useAnalytics.ts — для обычной
# сборки ничего задавать не нужно. Переменные ниже только переопределяют его.

# Другое GA4-свойство (формат G-XXXXXXXXXX). Пустое значение полностью
# отключает аналитику. Держите закомментированным, если не нужно.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Включает трекинг вне прода (npm run dev) и добавляет debug_mode,
# чтобы события были видны в GA4 → Admin → DebugView.
# VITE_GA_DEBUG=1
