CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Google Analytics 4.
# События уходят сразу в два ресурса, оба зашиты в
# src/composables/useAnalytics.ts — для обычной сборки задавать ничего не нужно:
#   G-GFQ08LC8YJ — ресурс «Makeberry Affiliates» (DP-14089), отчёты смотрим тут;
#   G-HR253V0PJX — ресурс из DP-15355, доступа к нему у нас нет.

# Переопределяет список ЦЕЛИКОМ: один ID или несколько через запятую.
# Нужно только чтобы оставить ровно один ресурс. Пустое значение полностью
# отключает аналитику. Держите закомментированным, если не нужно.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Включает трекинг вне прода (npm run dev) и добавляет debug_mode,
# чтобы события были видны в GA4 → Admin → DebugView.
# VITE_GA_DEBUG=1
